// prisma/schema.prisma  –  myyatracircle.com (PostgreSQL)
// Prisma 7 style: the DB url lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  LOGO
}

enum MediaType {
  IMAGE
  VIDEO
}

enum InclusionKind {
  INCLUSION
  EXCLUSION
}

// ───────── Admin & settings ─────────
model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model SiteSetting {
  key       String   @id // logo, phone, email, address, footerText, gaCode ...
  value     String?
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  platform  String
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ───────── Media library ─────────
model Media {
  id           Int       @id @default(autoincrement())
  url          String    @unique
  publicId     String // Cloudinary id, needed to delete the file later
  resourceType String    @default("image") // Cloudinary: image | video | raw
  kind         MediaKind @default(IMAGE)
  name         String
  altText      String?
  tags         String[]
  bytes        Int?
  width        Int?
  height       Int?
  mimeType     String?
  createdAt    DateTime  @default(now())

  @@index([kind, createdAt])
}

// ───────── Homepage ─────────
model HeroBanner {
  id         Int     @id @default(autoincrement())
  mediaUrl   String
  mediaType  String  @default("image") // image | video
  heading    String?
  subHeading String?
  ctaText    String?
  ctaUrl     String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model HomepageSection {
  key       String  @id // hero, featuredDestinations, featuredPackages ...
  title     String?
  subtitle  String?
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

// ───────── Destinations → Places ─────────
model Destination {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  region           String?
  state            String?
  shortDescription String?
  overview         String?
  bannerImage      String?
  bannerType       MediaType @default(IMAGE)
  thumbnailImage   String?
  isFeatured       Boolean  @default(false)
  featuredOrder    Int?
  sortOrder        Int      @default(0)
  status           Status   @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gallery     DestinationMedia[]
  places      Place[]
  packages    PackageDestination[]
  experiences ExperienceDestination[]
}

model DestinationMedia {
  id            Int         @id @default(autoincrement())
  destinationId Int
  url           String
  type          MediaType   @default(IMAGE)
  sortOrder     Int         @default(0)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Place {
  id              Int         @id @default(autoincrement())
  destinationId   Int
  name            String
  slug            String      @unique
  about           String?
  heroImage       String?
  heroType        MediaType   @default(IMAGE)
  thumbnailImage  String?
  sortOrder       Int         @default(0)
  status          Status      @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  gallery         PlaceMedia[]
}

model PlaceMedia {
  id        Int       @id @default(autoincrement())
  placeId   Int
  url       String
  type      MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

// ───────── Tour packages ─────────
model TourPackage {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  durationDays     Int?
  durationNights   Int?
  shortDescription String?
  overview         String?
  heroImage        String?
  heroType         MediaType @default(IMAGE)
  thumbnailImage   String?
  isFeatured       Boolean  @default(false)
  featuredOrder    Int?
  sortOrder        Int      @default(0)
  status           Status   @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  destinations PackageDestination[]
  itinerary    ItineraryDay[]
  highlights   PackageHighlight[]
  inclusions   PackageInclusion[]
  gallery      PackageMedia[]
  inquiries    TourInquiry[]
}

model PackageDestination {
  packageId     Int
  destinationId Int
  package       TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([packageId, destinationId])
}

model ItineraryDay {
  id          Int         @id @default(autoincrement())
  packageId   Int
  dayNumber   Int
  title       String
  description String?
  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
}

model PackageHighlight {
  id        Int         @id @default(autoincrement())
  packageId Int
  text      String
  sortOrder Int         @default(0)
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model PackageInclusion {
  id        Int           @id @default(autoincrement())
  packageId Int
  kind      InclusionKind
  text      String
  sortOrder Int           @default(0)
  package   TourPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model PackageMedia {
  id        Int         @id @default(autoincrement())
  packageId Int
  url       String
  type      MediaType   @default(IMAGE)
  sortOrder Int         @default(0)
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

// ───────── Experiences ─────────
model Experience {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  shortDescription String?
  overview         String?
  heroImage        String?
  heroType         MediaType @default(IMAGE)
  thumbnailImage   String?
  isFeatured       Boolean  @default(false)
  featuredOrder    Int?
  sortOrder        Int      @default(0)
  status           Status   @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  highlights   ExperienceHighlight[]
  gallery      ExperienceMedia[]
  destinations ExperienceDestination[]
}

model ExperienceHighlight {
  id           Int        @id @default(autoincrement())
  experienceId Int
  text         String
  sortOrder    Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model ExperienceMedia {
  id           Int        @id @default(autoincrement())
  experienceId Int
  url          String
  type         MediaType  @default(IMAGE)
  sortOrder    Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model ExperienceDestination {
  experienceId  Int
  destinationId Int
  experience    Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([experienceId, destinationId])
}

// ───────── Testimonials / Blog / FAQ ─────────
model Testimonial {
  id           Int      @id @default(autoincrement())
  travelerName String
  location     String?
  feedback     String
  imageUrl     String?
  isApproved   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model BlogCategory {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  blogs Blog[]
}

model Blog {
  id               Int           @id @default(autoincrement())
  categoryId       Int?
  title            String
  slug             String        @unique
  shortDescription String?
  content          String
  featuredImage    String?
  publishedAt      DateTime?
  isFeatured       Boolean       @default(false)
  status           Status        @default(DRAFT)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  category         BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ───────── CMS pages / About / Team ─────────
model Page {
  id              Int           @id @default(autoincrement())
  slug            String        @unique // about-us, privacy-policy, terms-and-conditions ...
  title           String
  content         String?
  isActive        Boolean       @default(true)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]
}

model PageSection {
  id         Int     @id @default(autoincrement())
  pageId     Int
  sectionKey String // brandStory, vision, mission, expertise ...
  title      String?
  content    String?
  imageUrl   String?
  sortOrder  Int     @default(0)
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
}

model WhyUsItem {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model TeamMember {
  id          Int     @id @default(autoincrement())
  name        String
  designation String?
  bio         String?
  photoUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

// ───────── Form submissions ─────────
model ContactInquiry {
  id                    Int           @id @default(autoincrement())
  name                  String
  email                 String
  phone                 String?
  country               String?
  destinationOfInterest String?
  message               String?
  status                InquiryStatus @default(NEW)
  createdAt             DateTime      @default(now())
}

model TourInquiry {
  id        Int           @id @default(autoincrement())
  packageId Int?
  name      String
  email     String
  phone     String?
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  package   TourPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model HolidayInquiry {
  id                      Int           @id @default(autoincrement())
  name                    String
  email                   String
  phone                   String?
  preferredDestination    String?
  travelStartDate         DateTime?     @db.Date
  travelEndDate           DateTime?     @db.Date
  numTravelers            Int?
  budgetRange             String?
  accommodationPreference String?
  specialRequirements     String?
  status                  InquiryStatus @default(NEW)
  createdAt               DateTime      @default(now())
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}
